<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cartograph.code-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CARTOGRAPH_ROOT__/scripts/serve-code-server.sh</string>
    <string>--foreground</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__CARTOGRAPH_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CARTOGRAPH_ROOT</key>
    <string>__CARTOGRAPH_ROOT__</string>
    <!-- launchd agents get a bare PATH; code-server lives under a brew
         prefix, so the script's binary probe needs these on PATH. -->
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__CARTOGRAPH_ROOT__/.cartograph/logs/code-server.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CARTOGRAPH_ROOT__/.cartograph/logs/code-server.err.log</string>
</dict>
</plist>
