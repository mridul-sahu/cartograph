<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cartograph.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CARTOGRAPH_ROOT__/scripts/serve-cartograph.sh</string>
    <string>--foreground</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__CARTOGRAPH_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CARTOGRAPH_ROOT</key>
    <string>__CARTOGRAPH_ROOT__</string>
    <key>CARTOGRAPH_PYTHON</key>
    <string>__CARTOGRAPH_PYTHON__</string>
    <!-- launchd IS the supervisor: uvicorn reload would churn endlessly on
         serve.py's own state writes, and KeepAlive handles real crashes. -->
    <key>CARTOGRAPH_RELOAD</key>
    <string>0</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__CARTOGRAPH_ROOT__/.cartograph/logs/serve.out.log</string>
  <key>StandardErrorPath</key>
  <string>__CARTOGRAPH_ROOT__/.cartograph/logs/serve.err.log</string>
</dict>
</plist>
