{
  "workbench.startupEditor": "readme",
  "//theme": "Follow the browser/OS colour scheme \u2014 when the system is in",
  "//theme2": "dark mode, code-server uses the dark theme, matching cartograph",
  "//theme3": "(whose toggle also defaults to prefers-color-scheme).",
  "//trust": "Embedded IDE only ever opens our own local forks \u2014 the",
  "//trust2": "workspace-trust gate is pure friction and blocks extensions.",
  "security.workspace.trust.enabled": false,
  "window.autoDetectColorScheme": false,
  "workbench.preferredLightColorTheme": "Default Light Modern",
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.activityBar.location": "default",
  "workbench.enableExperiments": false,
  "workbench.editor.enablePreview": true,
  "explorer.openEditors.visible": 0,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "//": "\u2500\u2500 PERFORMANCE \u2014 these are the lag fixes for big repos \u2500\u2500",
  "//1": "Stop the file watcher from tracking generated / vendored trees.",
  "//1b": "On JAX/XLA this is the single biggest lag source \u2014 tens of",
  "//1c": "thousands of fsevents from bazel-out etc.",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/bazel-out/**": true,
    "**/bazel-bin/**": true,
    "**/bazel-testlogs/**": true,
    "**/bazel-*/**": true,
    "**/__pycache__/**": true,
    "**/node_modules/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.tox/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/*.egg-info/**": true,
    "**/.code-server-data/**": true
  },
  "//2": "Keep these out of the file tree entirely.",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/bazel-out": true,
    "**/bazel-bin": true,
    "**/bazel-testlogs": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.tox": true,
    "**/node_modules": true,
    "**/*.egg-info": true
  },
  "//3": "Keep search fast \u2014 don't grind through generated trees.",
  "search.exclude": {
    "**/bazel-out": true,
    "**/bazel-bin": true,
    "**/bazel-testlogs": true,
    "**/bazel-*": true,
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/build": true,
    "**/dist": true,
    "**/*.egg-info": true
  },
  "search.useGlobalIgnoreFiles": true,
  "search.useIgnoreFiles": true,
  "search.followSymlinks": false,
  "search.smartCase": true,
  "//4": "Pyright is the lag source on Python repos. openFilesOnly stops",
  "//4b": "it from type-checking the entire repo in the background; only",
  "//4c": "the files you actually have open get analysed.",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexing": false,
  "python.analysis.autoImportCompletions": false,
  "python.analysis.persistAllIndices": false,
  "python.analysis.userFileIndexingLimit": 2000,
  "python.languageServer": "None",
  "python.terminal.activateEnvironment": false,
  "//5": "git status on a huge working tree is a recurring stutter.",
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": true,
  "git.openRepositoryInParentFolders": "never",
  "scm.diffDecorations": "gutter",
  "//6": "Render-cost trims.",
  "editor.minimap.enabled": false,
  "editor.largeFileOptimizations": true,
  "editor.experimental.asyncTokenization": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.renderWhitespace": "boundary",
  "editor.cursorSurroundingLines": 8,
  "editor.rulers": [
    80,
    100
  ],
  "editor.tabSize": 4,
  "editor.detectIndentation": true,
  "editor.fontFamily": "'JetBrains Mono', 'Menlo', 'Consolas', monospace",
  "editor.fontSize": 13,
  "editor.lineHeight": 20,
  "editor.fontLigatures": false,
  "//7": "Don't spend cycles on things the embedded use case doesn't need.",
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "extensions.ignoreRecommendations": true,
  "npm.autoDetect": "off",
  "typescript.tsserver.maxTsServerMemory": 2048,
  "breadcrumbs.enabled": true,
  "window.menuBarVisibility": "hidden",
  "window.titleBarStyle": "custom",
  "window.restoreWindows": "preserve",
  "workbench.colorTheme": "Default Dark Modern"
}
