{
  "permissions": {
    "allow": [
      "Bash(./scripts/*)",
      "Bash(./scripts/**)",
      "Bash(bash ./scripts/*)",
      "Bash(bash ./scripts/**)",
      "Bash(./scripts/upstream-sync.sh:*)",
      "Bash(./scripts/inject-context.sh:*)",
      "Bash(./scripts/episode-prompt.sh:*)",
      "Bash(./scripts/session-log.sh:*)",
      "Bash(./scripts/token-check.sh:*)",
      "Bash(./scripts/digest.sh:*)",
      "Bash(./scripts/doctor.sh:*)",
      "Bash(./scripts/fork-setup.sh:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git remote*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git symbolic-ref*)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "Bash(git config user.email)",
      "Bash(git config user.name)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(bat *)",
      "Bash(just *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(jq *)",
      "Bash(gh api user*)",
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue list*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/inject-context.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/session-stop.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/post-edit.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/session-log.sh touch"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/pre-read-augment.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/pre-edit-augment.sh"
          }
        ]
      }
    ]
  }
}
