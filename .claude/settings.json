{
  "permissions": {
    "allow": [
      "Bash(./scripts/*)",
      "Bash(./scripts/**)",
      "Bash(bash ./scripts/*)",
      "Bash(bash ./scripts/**)",
      "Bash(./scripts/upstream-sync.sh:*)",
      "Bash(./scripts/inject-context.sh:*)",
      "Bash(./scripts/episode-prompt.sh:*)",
      "Bash(./scripts/session-log.sh:*)",
      "Bash(./scripts/token-check.sh:*)",
      "Bash(./scripts/digest.sh:*)",
      "Bash(./scripts/doctor.sh:*)",
      "Bash(./scripts/fork-setup.sh:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git remote*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git symbolic-ref*)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "Bash(git config user.email)",
      "Bash(git config user.name)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(bat *)",
      "Bash(just *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(jq *)",
      "Bash(gh api user*)",
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue list*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/session-log.sh start"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/upstream-sync.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/digest.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/auto-promote.sh"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/build-file-index.py --quiet"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/build-search-index.py --quiet"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/anchor-coverage.py > /dev/null"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/diary.sh --if-stale"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/inject-context.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/episode-prompt.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/usage-audit.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/update-note-usage.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/session-log.sh stop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/token-check.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/session-log.sh touch"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/post-edit-topic-mark.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/normalize-note-frontmatter.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/session-log.sh touch"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/pre-read-augment.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/pre-edit-augment.sh"
          }
        ]
      }
    ]
  }
}
