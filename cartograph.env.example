# cartograph.env — local configuration. Copy this file to `cartograph.env`
# and fill in your values. The real file is gitignored; only this template
# is committed.

# GitHub account used for `gh auth`, fork creation, and PR author queries.
CARTOGRAPH_GITHUB_USER=your-github-username

# Identity written into per-fork `.git/config` by `just add-repo`.
# Usually the same as CARTOGRAPH_GITHUB_USER + an email tied to that account.
CARTOGRAPH_GIT_USER_NAME=your-github-username
CARTOGRAPH_GIT_USER_EMAIL=you@example.com

# SSH host alias used when constructing fork/upstream URLs
# (`git@<alias>:owner/repo.git`). Default is "github.com". Set this to a
# custom alias from your ~/.ssh/config if you keep a dedicated key for this
# account (e.g. "github.com-work").
CARTOGRAPH_SSH_HOST_ALIAS=github.com

# Optional: explicit ssh command for each fork's `core.sshCommand` (pins a
# specific key). Leave empty to inherit the shell's default ssh config.
# Example: ssh -i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes
CARTOGRAPH_SSH_COMMAND=

# Comma-separated extra forbidden tokens for the bedrock prompt + lint and
# token-check. The framework already scrubs these universally:
#   cartograph, anthropic, claude code, claude opus, claude sonnet, claude haiku
# Add anything else that must never appear in user-facing content — your
# company name, internal codenames, alternate identities, etc.
CARTOGRAPH_FORBIDDEN_EXTRAS=
