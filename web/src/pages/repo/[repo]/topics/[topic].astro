---
import Base from '~/layouts/Base.astro';
import Chip from '~/components/Chip.astro';
import MermaidRehydrator from '~/components/islands/Mermaid.tsx';
import AuditPanel from '~/components/islands/AuditPanel.tsx';
import ContentActions from '~/components/islands/ContentActions.tsx';
import BookmarkButton from '~/components/islands/BookmarkButton.tsx';
import RelatedNotes from '~/components/islands/RelatedNotes.tsx';
import AnchorCoverageCallout from '~/components/islands/AnchorCoverageCallout.tsx';
import Backlinks from '~/components/islands/Backlinks.tsx';
import DriftCallout from '~/components/islands/DriftCallout.tsx';
import { REPOS } from '~/lib/repos';
import { loadTopic, loadTopics } from '~/lib/content';
import { renderMarkdown } from '~/lib/markdown';
import { linkifyCodeAnchors } from '~/lib/anchors';
import { formatDate } from '~/lib/time';

export function getStaticPaths() {
  return REPOS.flatMap((repo) =>
    loadTopics(repo).map((t) => ({ params: { repo, topic: t.slug } }))
  );
}

const { repo, topic } = Astro.params as { repo: string; topic: string };
const doc = loadTopic(repo, topic);
if (!doc) {
  return Astro.redirect(`/repo/${repo}/`);
}

const { html: rawHtml, headings } = await renderMarkdown(doc.body);
const html = linkifyCodeAnchors(rawHtml, repo);

// Prev / next within the same repo, alphabetical.
const siblings = loadTopics(repo);
const idx = siblings.findIndex((s) => s.slug === topic);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const synthesized = Boolean(doc.data.synthesized_from_exploration);
const reviewed = doc.data.reviewed_by_human;

// Audit panel props — normalise frontmatter sentinels (`~`, '', null) to a
// real null so the React island gets a stable shape.
function normalizeNullish(v: unknown): string | null {
  if (v == null) return null;
  const s = String(v).trim();
  if (!s || s === '~') return null;
  return s;
}
const initialReviewed = normalizeNullish(doc.data.reviewed_by_human);
const initialNotes = normalizeNullish(doc.data.review_notes);
---

<Base
  title={`${topic} · ${repo}`}
  breadcrumbs={[
    { label: 'dashboard', href: '/' },
    { label: repo, href: `/repo/${repo}/` },
    { label: 'topics' },
    { label: topic },
  ]}
>
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-10">
    <article class="min-w-0">
      <DriftCallout repo={repo} slug={topic} client:load />
      <AnchorCoverageCallout repo={repo} slug={topic} client:load />
      <header class="mb-8">
        <div class="font-mono text-xs text-muted uppercase tracking-widest mb-2 flex items-center gap-3">
          <span>{repo}</span>
          <span class="text-border">·</span>
          <span>topic</span>
          {synthesized && <Chip tone="warn">synthesized</Chip>}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tightish font-mono">{topic}</h1>
        {doc.data.last_revised && (
          <p class="mt-2 font-mono text-xs text-muted">last revised {formatDate(doc.data.last_revised as string)}</p>
        )}
      </header>
      <div class="prose-cartograph" set:html={html} />

      {(prev || next) && (
        <nav class="mt-16 grid grid-cols-2 gap-4 border-t-2 border-border pt-6">
          {prev ? (
            <a href={`/repo/${repo}/topics/${prev.slug}/`} class="brutal-card p-4 no-underline">
              <div class="font-mono text-xs text-muted uppercase tracking-widest">← prev</div>
              <div class="font-mono mt-1">{prev.slug}</div>
            </a>
          ) : <span />}
          {next ? (
            <a href={`/repo/${repo}/topics/${next.slug}/`} class="brutal-card p-4 text-right no-underline">
              <div class="font-mono text-xs text-muted uppercase tracking-widest">next →</div>
              <div class="font-mono mt-1">{next.slug}</div>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>

    <aside class="lg:sticky lg:top-24 self-start space-y-6 text-sm">
      <div class="brutal-card p-4">
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">frontmatter</h3>
        <dl class="grid grid-cols-[8rem_1fr] gap-x-2 gap-y-1.5 font-mono text-xs">
          <dt class="text-muted">repo</dt><dd>{repo}</dd>
          <dt class="text-muted">topic</dt><dd>{topic}</dd>
          {doc.data.layer && (<><dt class="text-muted">layer</dt><dd>{String(doc.data.layer)}</dd></>)}
          {doc.data.last_revised && (<><dt class="text-muted">revised</dt><dd>{formatDate(doc.data.last_revised as string)}</dd></>)}
          <dt class="text-muted">reviewed</dt><dd>{reviewed ? formatDate(String(reviewed)) : '—'}</dd>
          <dt class="text-muted">words</dt><dd>{doc.wordCount.toLocaleString()}</dd>
        </dl>
        {Array.isArray(doc.data.distilled_from) && (doc.data.distilled_from as string[]).length > 0 && (
          <div class="mt-3">
            <div class="font-mono text-xs uppercase tracking-widest text-muted mb-1">distilled from</div>
            <ul class="font-mono text-xs space-y-1">
              {(doc.data.distilled_from as string[]).map((s) => <li class="text-muted truncate">{s}</li>)}
            </ul>
          </div>
        )}
      </div>

      <AuditPanel
        repo={repo}
        topic={topic}
        initialReviewed={initialReviewed}
        initialNotes={initialNotes}
        client:load
      />

      <ContentActions
        kind="topic"
        repo={repo}
        slug={topic}
        filePath={`guides/${repo}/topics/${topic}.md`}
        client:load
      />

      <div class="brutal-card p-4">
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">pin</h3>
        <BookmarkButton path={`guides/${repo}/topics/${topic}.md`} title={topic} client:load />
      </div>

      <div class="brutal-card p-4">
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">related</h3>
        <RelatedNotes path={`guides/${repo}/topics/${topic}.md`} client:visible />
      </div>

      <div class="brutal-card p-4">
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">backlinks</h3>
        <Backlinks path={`guides/${repo}/topics/${topic}.md`} client:visible />
      </div>

      {tocHeadings.length > 0 && (
        <div class="brutal-card p-4">
          <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">on this page</h3>
          <ul class="space-y-1.5 text-sm">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'pl-3 text-muted' : ''}>
                <a href={`#${h.id}`} class="hover:text-accent">{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <MermaidRehydrator client:visible />
</Base>
