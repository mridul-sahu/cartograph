---
import Base from '~/layouts/Base.astro';
import Chip from '~/components/Chip.astro';
import MermaidRehydrator from '~/components/islands/Mermaid.tsx';
import { REPOS } from '~/lib/repos';
import { loadDesignsForRepo, loadDesign } from '~/lib/content';
import { renderMarkdown } from '~/lib/markdown';

export function getStaticPaths() {
  return REPOS.flatMap((repo) =>
    loadDesignsForRepo(repo).map((d) => ({ params: { repo, slug: d.slug } })),
  );
}

const { repo, slug } = Astro.params as { repo: string; slug: string };
const design = loadDesign(repo, slug);
if (!design) {
  return Astro.redirect('/designs/');
}

const { html, headings } = design.readme
  ? await renderMarkdown(design.readme.body)
  : { html: null, headings: [] };
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const primaryDeliverable = design.deliverables[0] ?? null;
const gdocUrl =
  design.readme && typeof design.readme.data.gdoc_url === 'string'
    ? design.readme.data.gdoc_url
    : null;

const codeServerOrigin = 'http://localhost:47780';
const ideUrl = `${codeServerOrigin}/?folder=${encodeURIComponent(design.dir)}`;

const siblings = loadDesignsForRepo(repo);
const idx = siblings.findIndex((d) => d.slug === slug);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;
---

<Base
  title={`${design.title} · design · ${repo}`}
  breadcrumbs={[
    { label: 'dashboard', href: '/' },
    { label: 'designs', href: '/designs/' },
    { label: repo, href: `/repo/${repo}/` },
    { label: design.slug },
  ]}
>
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-10">
    <article class="min-w-0">
      <header class="mb-8">
        <div class="font-mono text-xs text-muted uppercase tracking-widest mb-2 flex items-center gap-3 flex-wrap">
          <span>design</span>
          <span class="text-border">·</span>
          <a href={`/repo/${repo}/`} class="hover:text-accent">{repo}</a>
          {primaryDeliverable && <Chip tone="accent" size="sm">{primaryDeliverable.ext.replace(/^\./, '')}</Chip>}
        </div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tightish leading-tight">{design.title}</h1>
        <p class="mt-2 font-mono text-xs text-muted break-all">designs/{repo}/{design.slug}/</p>
      </header>

      {html ? (
        <div class="prose-cartograph" set:html={html} />
      ) : (
        <div class="brutal-card p-6 text-muted text-sm">
          no README.md at <code>designs/{repo}/{design.slug}/README.md</code>.
        </div>
      )}

      {(prev || next) && (
        <nav class="mt-16 grid grid-cols-2 gap-4 border-t-2 border-border pt-6">
          {prev ? (
            <a href={`/designs/${repo}/${prev.slug}/`} class="brutal-card p-4">
              <div class="font-mono text-xs text-muted uppercase tracking-widest">← prev</div>
              <div class="font-mono mt-1 truncate">{prev.slug}</div>
            </a>
          ) : <span />}
          {next ? (
            <a href={`/designs/${repo}/${next.slug}/`} class="brutal-card p-4 text-right">
              <div class="font-mono text-xs text-muted uppercase tracking-widest">next →</div>
              <div class="font-mono mt-1 truncate">{next.slug}</div>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>

    <aside class="lg:sticky lg:top-24 self-start space-y-6 text-sm">
      {/* Primary CTA — the .docx is the deliverable; everything else routes
          through this. Stacked vertically so the download is the loudest. */}
      <div class="space-y-2">
        {primaryDeliverable && (
          <a
            href={primaryDeliverable.url}
            download={primaryDeliverable.name}
            class="brutal-button brutal-button-accent w-full justify-center font-mono text-xs"
          >
            download {primaryDeliverable.name} ↓
          </a>
        )}
        {gdocUrl && (
          <a
            href={gdocUrl}
            target="_blank"
            rel="noopener"
            class="brutal-button w-full justify-center font-mono text-xs"
          >
            open in Google Docs ↗
          </a>
        )}
        <a
          href={ideUrl}
          target="_blank"
          rel="noopener"
          class="brutal-button w-full justify-center font-mono text-xs"
        >
          open in VS Code ↗
        </a>
      </div>

      <div class="brutal-card p-4">
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">frontmatter</h3>
        <dl class="grid grid-cols-[5rem_1fr] gap-x-2 gap-y-1.5 font-mono text-xs">
          <dt class="text-muted">repo</dt><dd>{repo}</dd>
          <dt class="text-muted">slug</dt><dd class="break-all">{design.slug}</dd>
          {design.readme?.data.last_revised && (
            <>
              <dt class="text-muted">revised</dt>
              <dd>{String(design.readme.data.last_revised)}</dd>
            </>
          )}
          {design.readme && (
            <>
              <dt class="text-muted">words</dt>
              <dd>{design.readme.wordCount.toLocaleString()}</dd>
            </>
          )}
        </dl>
      </div>

      {design.deliverables.length > 0 && (
        <div class="brutal-card p-4">
          <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
            deliverable{design.deliverables.length === 1 ? '' : 's'}
          </h3>
          <ul class="space-y-1.5 font-mono text-xs">
            {design.deliverables.map((dl) => (
              <li class="flex items-baseline justify-between gap-2">
                <a href={dl.url} download={dl.name} class="text-fg hover:text-accent break-all">
                  {dl.name}
                </a>
                <span class="text-muted shrink-0">{(dl.size / 1024).toFixed(0)}KB</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {tocHeadings.length > 0 && (
        <div class="brutal-card p-4">
          <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">on this page</h3>
          <ul class="space-y-1.5 text-sm">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'pl-3 text-muted' : ''}>
                <a href={`#${h.id}`} class="hover:text-accent">{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <MermaidRehydrator client:visible />
</Base>
