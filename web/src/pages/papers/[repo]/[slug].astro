---
import Base from '~/layouts/Base.astro';
import Chip from '~/components/Chip.astro';
import ContentActions from '~/components/islands/ContentActions.tsx';
import MermaidRehydrator from '~/components/islands/Mermaid.tsx';
import BookmarkButton from '~/components/islands/BookmarkButton.tsx';
import RelatedNotes from '~/components/islands/RelatedNotes.tsx';
import Backlinks from '~/components/islands/Backlinks.tsx';
import { REPOS } from '~/lib/repos';
import { loadPapers, loadPaper } from '~/lib/content';
import { renderMarkdown } from '~/lib/markdown';
import { formatDate } from '~/lib/time';

export function getStaticPaths() {
  return REPOS.flatMap((repo) =>
    loadPapers(repo).map((p) => ({ params: { repo, slug: p.slug } })),
  );
}

const { repo, slug } = Astro.params as { repo: string; slug: string };
const doc = loadPaper(repo, slug);
if (!doc) {
  return Astro.redirect('/papers/');
}

const { html, headings } = await renderMarkdown(doc.body);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const title = typeof doc.data.title === 'string' ? doc.data.title : slug;
const authors = Array.isArray(doc.data.authors) ? (doc.data.authors as string[]) : [];
const year = doc.data.year;
const url = typeof doc.data.url === 'string' ? doc.data.url : null;
const arxiv = typeof doc.data.arxiv === 'string' ? doc.data.arxiv : null;
const tags = Array.isArray(doc.data.tags) ? (doc.data.tags as string[]) : [];

// PDF served by FastAPI from papers/<repo>/<slug>/<pdf-name> if present.
const pdfName = typeof doc.data.pdf === 'string' ? doc.data.pdf : 'paper.pdf';
const pdfUrl = doc.hasPdf ? `/api/paper-pdf/${repo}/${slug}/${pdfName}` : null;
---

<Base
  title={`${title} · paper · ${repo}`}
  breadcrumbs={[
    { label: 'dashboard', href: '/' },
    { label: 'papers', href: '/papers/' },
    { label: repo, href: `/repo/${repo}/` },
    { label: slug },
  ]}
  fullWidth={pdfUrl !== null}
>
  {pdfUrl ? (
    <!-- WITH PDF: two-column grid — left = PDF iframe sticky, right = notes + sidebar -->
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] gap-4 h-[calc(100vh-130px)] min-h-[600px]">
      <aside class="brutal-card p-0 overflow-hidden flex flex-col min-w-0 min-h-0 order-2 xl:order-1">
        <div class="px-3 py-2 border-b-2 border-border bg-muted-bg font-mono text-xs flex justify-between items-center gap-3">
          <span class="text-muted uppercase tracking-widest text-[10px]">pdf · {pdfName}</span>
          <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent">open ↗</a>
        </div>
        <iframe
          src={pdfUrl}
          title={`${title} (PDF)`}
          class="flex-1 w-full border-0 bg-bg"
          loading="eager"
        />
      </aside>

      <div class="overflow-auto min-h-0 order-1 xl:order-2 pr-2">
        <header class="mb-6">
          <div class="font-mono text-xs text-muted uppercase tracking-widest mb-2 flex items-center gap-3 flex-wrap">
            <span>paper</span>
            <span class="text-border">·</span>
            <a href={`/repo/${repo}/`} class="hover:text-accent">{repo}</a>
            <Chip tone="accent">pdf</Chip>
          </div>
          <h1 class="text-2xl md:text-3xl font-bold tracking-tightish leading-tight">{title}</h1>
          <div class="mt-2 font-mono text-xs text-muted">
            {authors.length > 0 && <span>{authors.join(', ')}</span>}
            {year && <span> · {year}</span>}
            {arxiv && <span> · arXiv:{arxiv}</span>}
            {url && (
              <span>
                {' · '}<a href={url} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent">{url} ↗</a>
              </span>
            )}
          </div>
        </header>

        <article class="prose-cartograph" set:html={html} />

        <div class="mt-8 space-y-4 max-w-2xl">
          <ContentActions
            kind="paper"
            repo={repo}
            slug={slug}
            filePath={`papers/${repo}/${slug}/notes.md`}
            client:load
          />
        </div>
      </div>
    </div>
  ) : (
    <!-- NO PDF: single article + sidebar layout (the normal docs shape) -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-10">
      <article class="min-w-0">
        <header class="mb-8">
          <div class="font-mono text-xs text-muted uppercase tracking-widest mb-2 flex items-center gap-3 flex-wrap">
            <span>paper</span>
            <span class="text-border">·</span>
            <a href={`/repo/${repo}/`} class="hover:text-accent">{repo}</a>
            {/* The chip signals where the canonical PDF lives. With no local
                PDF AND no external URL → 'no pdf' (genuine). With an arxiv id
                or url → link out to it; the chip stops being a contradiction
                with the link the user can already see below. */}
            {arxiv ? (
              <a
                href={`https://arxiv.org/abs/${arxiv}`}
                target="_blank"
                rel="noopener noreferrer"
                class="no-underline"
              ><Chip tone="accent" size="sm">arxiv ↗</Chip></a>
            ) : url ? (
              <a href={url} target="_blank" rel="noopener noreferrer" class="no-underline">
                <Chip tone="accent" size="sm">external pdf ↗</Chip>
              </a>
            ) : (
              <Chip size="sm">no pdf</Chip>
            )}
          </div>
          <h1 class="text-3xl md:text-4xl font-bold tracking-tightish leading-tight">{title}</h1>
          <div class="mt-2 font-mono text-xs text-muted flex items-baseline gap-2 flex-wrap">
            {authors.length > 0 && <span>{authors.join(', ')}</span>}
            {year && <span>· {year}</span>}
            {arxiv && <span>· arXiv:{arxiv}</span>}
            {url && (
              <>
                <span>·</span>
                <a href={url} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent">{url} ↗</a>
              </>
            )}
          </div>
          {!doc.hasPdf && (arxiv || url) && (
            <p class="mt-3 font-mono text-xs text-muted">
              PDF is hosted externally — drop a local copy at <code>papers/{repo}/{slug}/{pdfName}</code> to embed it inline.
            </p>
          )}
          {!doc.hasPdf && !arxiv && !url && (
            <p class="mt-3 font-mono text-xs text-muted">
              no PDF — drop one at <code>papers/{repo}/{slug}/{pdfName}</code> or set <code>url:</code> / <code>arxiv:</code> in the frontmatter.
            </p>
          )}
        </header>

        <div class="prose-cartograph" set:html={html} />
      </article>

      <aside class="lg:sticky lg:top-32 self-start space-y-4 text-sm">
        {(() => {
          const notePath = `papers/${repo}/${slug}/notes.md`;
          return (
            <>
              <div class="brutal-card p-4">
                <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-2">pin</h3>
                <BookmarkButton path={notePath} title={slug} client:load />
              </div>
              <div class="brutal-card p-4">
                <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-2">related</h3>
                <RelatedNotes path={notePath} client:visible />
              </div>
              <div class="brutal-card p-4">
                <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-2">backlinks</h3>
                <Backlinks path={notePath} client:visible />
              </div>
            </>
          );
        })()}

        <div class="brutal-card p-4">
          <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-2">frontmatter</h3>
          <dl class="grid grid-cols-[6rem_1fr] gap-x-2 gap-y-1.5 font-mono text-xs">
            <dt class="text-muted">repo</dt><dd>{repo}</dd>
            <dt class="text-muted">slug</dt><dd class="break-all">{slug}</dd>
            {doc.data.last_revised && (<><dt class="text-muted">revised</dt><dd>{formatDate(String(doc.data.last_revised))}</dd></>)}
            <dt class="text-muted">words</dt><dd>{doc.wordCount.toLocaleString()}</dd>
            {tags.length > 0 && (
              <>
                <dt class="text-muted">tags</dt>
                <dd class="flex flex-wrap gap-1">
                  {tags.map((t) => <code class="text-fg">{t}</code>)}
                </dd>
              </>
            )}
          </dl>
        </div>

        {tocHeadings.length > 0 && (
          <div class="brutal-card p-4">
            <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">on this page</h3>
            <ul class="space-y-1.5 text-sm">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? 'pl-3 text-muted' : ''}>
                  <a href={`#${h.id}`} class="hover:text-accent">{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <ContentActions
          kind="paper"
          repo={repo}
          slug={slug}
          filePath={`papers/${repo}/${slug}/notes.md`}
          client:load
        />
      </aside>
    </div>
  )}

  <MermaidRehydrator client:visible />
</Base>
