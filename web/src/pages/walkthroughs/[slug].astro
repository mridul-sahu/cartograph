---
import Base from '~/layouts/Base.astro';
import Chip from '~/components/Chip.astro';
import MermaidRehydrator from '~/components/islands/Mermaid.tsx';
import BookmarkButton from '~/components/islands/BookmarkButton.tsx';
import RelatedNotes from '~/components/islands/RelatedNotes.tsx';
import Backlinks from '~/components/islands/Backlinks.tsx';
import { loadAllWalkthroughs } from '~/lib/content';
import { renderMarkdown } from '~/lib/markdown';
import { formatDate } from '~/lib/time';

export function getStaticPaths() {
  return loadAllWalkthroughs().map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params as { slug: string };
const all = loadAllWalkthroughs().sort((a, b) => a.slug.localeCompare(b.slug));
const doc = all.find((d) => d.slug === slug);
if (!doc) {
  return Astro.redirect('/walkthroughs/');
}

// Strip the leading H1 so the rendered article doesn't duplicate the
// page header. We always print a single H1 from the page chrome.
const body = doc.body.replace(/^#\s+.+?\r?\n+/, '');
const { html, headings } = await renderMarkdown(body);

const idx = all.findIndex((d) => d.slug === slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

const repo = typeof doc.data.repo === 'string' ? doc.data.repo : null;
const topic = typeof doc.data.topic === 'string' ? doc.data.topic : null;
const lastRevised = doc.data.last_revised ? formatDate(String(doc.data.last_revised)) : null;

function extractTitle(body: string, fallback: string): string {
  const m = body.match(/^#\s+(.+?)\s*$/m);
  if (!m) return fallback;
  return m[1].replace(/`/g, '');
}
const title = extractTitle(doc.body, slug);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base
  title={`${slug} · walkthrough`}
  breadcrumbs={[
    { label: 'dashboard', href: '/' },
    { label: 'walkthroughs', href: '/walkthroughs/' },
    { label: slug },
  ]}
>
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-10">
    <article class="min-w-0">
      <header class="mb-8">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <Chip tone="accent">walkthrough</Chip>
          {repo && <Chip>{repo}</Chip>}
          {topic && <Chip>topic: {topic}</Chip>}
          {lastRevised && <Chip>revised · {lastRevised}</Chip>}
        </div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tightish leading-[1.1]">{title}</h1>
        <p class="mt-3 font-mono text-xs text-muted">
          {doc.wordCount.toLocaleString()} words · ~{Math.max(1, Math.round(doc.wordCount / 220))} min read
        </p>
      </header>

      <div class="prose-cartograph" set:html={html} />

      {(prev || next) && (
        <nav class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-4 border-t-2 border-border pt-6">
          {prev ? (
            <a href={`/walkthroughs/${prev.slug}/`} class="brutal-card p-4 no-underline">
              <div class="font-mono text-xs text-muted uppercase tracking-widest">← prev</div>
              <div class="font-mono mt-1 truncate">{prev.slug}</div>
            </a>
          ) : <span />}
          {next ? (
            <a href={`/walkthroughs/${next.slug}/`} class="brutal-card p-4 text-right no-underline">
              <div class="font-mono text-xs text-muted uppercase tracking-widest">next →</div>
              <div class="font-mono mt-1 truncate">{next.slug}</div>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>

    <aside class="lg:sticky lg:top-24 self-start space-y-6 text-sm">
      {(() => {
        const notePath = `learn/walkthroughs/${slug}.md`;
        return (
          <>
            <div class="brutal-card p-4">
              <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">pin</h3>
              <BookmarkButton path={notePath} title={slug} client:load />
            </div>
            <div class="brutal-card p-4">
              <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">related</h3>
              <RelatedNotes path={notePath} client:visible />
            </div>
            <div class="brutal-card p-4">
              <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">backlinks</h3>
              <Backlinks path={notePath} client:visible />
            </div>
          </>
        );
      })()}

      <div class="brutal-card p-4">
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">frontmatter</h3>
        <dl class="grid grid-cols-[6.5rem_1fr] gap-x-2 gap-y-1.5 font-mono text-xs">
          <dt class="text-muted">slug</dt><dd class="break-all">{slug}</dd>
          {repo && (<><dt class="text-muted">repo</dt><dd>{repo}</dd></>)}
          {topic && (<><dt class="text-muted">topic</dt><dd class="break-all">{topic}</dd></>)}
          {lastRevised && (<><dt class="text-muted">revised</dt><dd>{lastRevised}</dd></>)}
          <dt class="text-muted">words</dt><dd>{doc.wordCount.toLocaleString()}</dd>
        </dl>
      </div>

      {tocHeadings.length > 0 && (
        <div class="brutal-card p-4">
          <h3 class="font-mono text-xs uppercase tracking-widest text-muted mb-3">on this page</h3>
          <ul class="space-y-1.5 text-sm">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'pl-3 text-muted' : ''}>
                <a href={`#${h.id}`} class="hover:text-accent leading-snug block">{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <MermaidRehydrator client:visible />
</Base>
