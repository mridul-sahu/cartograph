---
// One node in the proposal tree. Renders the proposal as a card and, if it is an
// umbrella (has sub-proposals), nests its children indented beneath it with a
// connector rail. Recurses via Astro.self for arbitrary depth.
import { formatDate } from '~/lib/time';
import type { ProposalTreeNode } from '~/lib/content';

interface Props {
  node: ProposalTreeNode;
  repo: string;
  depth?: number;
}
const { node, repo, depth = 0 } = Astro.props;
const p = node.proposal;
const hasChildren = node.children.length > 0;

const statusClass: Record<string, string> = {
  'gap-analysis': 'text-muted border-border',
  'deep-dive': 'text-accent border-accent',
  final: 'text-green-700 border-green-600',
  'proposal-docx': 'text-green-700 border-green-600',
  'design-docx': 'text-green-700 border-green-600',
  implementing: 'text-green-700 border-green-600 font-semibold',
  discarded: 'text-muted border-border line-through',
  superseded: 'text-muted border-border line-through',
};
---
<div class={depth > 0 ? 'ml-4 border-l-2 border-border pl-4' : ''}>
  <a
    href={`/proposals/${repo}/${p.slug}/`}
    class="brutal-card p-4 no-underline block hover:border-accent transition-colors"
  >
    <div class="flex items-center justify-between gap-3 mb-1">
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`font-mono text-[10px] uppercase tracking-widest border px-1.5 py-0.5 ${statusClass[p.status] ?? statusClass['gap-analysis']}`}>{p.status}</span>
        {hasChildren && (
          <span class="font-mono text-[10px] uppercase tracking-widest text-accent border border-accent px-1.5 py-0.5">
            umbrella · {node.children.length} sub
          </span>
        )}
      </div>
      {p.data.last_revised && (
        <span class="font-mono text-xs text-muted flex-shrink-0">{formatDate(String(p.data.last_revised))}</span>
      )}
    </div>
    <h3 class="font-bold text-base leading-snug break-words">{p.title}</h3>
    {p.pitch && <p class="mt-1 text-sm text-muted line-clamp-2">{p.pitch}</p>}
    <div class="mt-2 font-mono text-[11px] text-muted truncate">{repo}/{p.slug}</div>
  </a>
  {hasChildren && (
    <div class="mt-3 space-y-3">
      {node.children.map((child) => (
        <Astro.self node={child} repo={repo} depth={depth + 1} />
      ))}
    </div>
  )}
</div>
